		{"id":"df2ea794047f0763","type":"text","text":"逃避","x":1120,"y":1365,"width":250,"height":60},
		{"id":"8a6b2b481c2e1b96","type":"text","text":"温和型行为控制（非正面冲突）","x":1550,"y":-665,"width":250,"height":60},
		{"id":"c02757989cc66f3f","type":"text","text":"同学/家人评价","x":1550,"y":-485,"width":250,"height":60},
		{"id":"7177f8f6afcfbcdd","type":"text","text":"自我评价与外界评价的冲突","x":1550,"y":-365,"width":250,"height":60},
		{"id":"5e1207edb8d859b5","type":"text","text":"女主为主角提供情感支持","x":1550,"y":295,"width":250,"height":60},
		{"id":"21f4906a0cea2fb8","type":"text","text":"遭到孤立","x":1550,"y":-1021,"width":250,"height":60},
		{"id":"496435bb80ee7694","type":"text","text":"评价","x":1550,"y":-855,"width":250,"height":60},
		{"id":"4fa963aedb748624","type":"text","text":"女主浅提了一嘴在哪上学（信息获取）","x":1550,"y":455,"width":250,"height":60},
		{"id":"fcb877a92dc5405b","type":"text","text":"主角在学校受到刺激，激动的爬上天台","x":1550,"y":575,"width":250,"height":60},
		{"id":"ed44b257deb49a4a","type":"text","text":"女主发现主角的背影并追上去","x":1550,"y":675,"width":250,"height":60},
		{"id":"97eb46ee8bf90702","type":"text","text":"女主把主角拉了下来（拥抱）","x":1550,"y":775,"width":250,"height":60},
		{"id":"386039bb43b55878","type":"text","text":"某天发现自己脑中突然多了一些记忆","x":1550,"y":875,"width":250,"height":60},
		{"id":"ab2f305ad2d4df57","type":"text","text":"遂询问主角在哪上学，并发现原来是同校学生","x":1550,"y":975,"width":250,"height":60},
		{"id":"c02d5d3a8c5565be","type":"text","text":"正面冲突","x":1120,"y":-75,"width":250,"height":60},
		{"id":"49b78a24a9dd7c2f","type":"text","text":"家长威胁（断生活费等）","x":1120,"y":45,"width":250,"height":60},
		{"id":"6739c0a63228aae7","type":"text","text":"幻影初次正式见面","x":1120,"y":205,"width":250,"height":60},
		{"id":"ac9d50bf8f7906af","type":"text","text":"共同交流（半夜时分）","x":1120,"y":365,"width":250,"height":60},
		{"id":"8afadfc8ca87f833","type":"text","text":"成绩/讨论","x":1120,"y":-555,"width":250,"height":60},
		{"id":"a19e520fa6128c34","type":"text","text":"展现自我认知","x":1120,"y":-435,"width":250,"height":60},
		{"id":"b7eb2d6b3202ecfc","type":"text","text":"尝试暗示家长","x":1120,"y":-180,"width":250,"height":60},
		{"id":"6f9246b33ea90168","type":"text","text":"人际","x":1120,"y":-925,"width":250,"height":60},
		{"id":"94a8a2a205ab0dcb","type":"text","text":"家庭","x":1120,"y":-768,"width":250,"height":60},
		{"id":"cd7c5bcb4ba22b19","type":"text","text":"赞同同龄人的评价（自我评价体系形成","x":1940,"y":-910,"width":250,"height":60},
		{"id":"c04b0bd31499ba53","type":"text","text":"苦难教育（铺垫成绩好的动机）","x":1940,"y":-795,"width":250,"height":60},
		{"id":"a1de5f69ff360774","type":"text","text":"完成最终救赎","x":1120,"y":3440,"width":250,"height":60},
		{"id":"94e39b8b0246b00e","type":"text","text":"再次在秘密基地见面","x":1120,"y":2790,"width":250,"height":60},
		{"id":"1e2e83e1b70b957c","type":"text","text":"主角向女主诉说了自己的成长，女主表示看在眼里","x":1120,"y":2905,"width":250,"height":60},
		{"id":"73aba11c29ca81af","type":"text","text":"两人不再刻意疏远","x":1120,"y":3025,"width":250,"height":60},
		{"id":"ed5ed8c29c0e4711","type":"text","text":"保留了纸条的习惯，例如主角生日时收到生日祝福","x":1120,"y":3154,"width":250,"height":60},
		{"id":"4f8187b638fe46c5","type":"text","text":"主角过度让自己独立，让事态恶化","x":1550,"y":2445,"width":250,"height":60},
		{"id":"29e17ec44aefc3fc","type":"text","text":"主角心情低落时收到小纸条","x":1550,"y":2565,"width":250,"height":60},
		{"id":"5bd3d9a2a1f9018d","type":"text","text":"在放纸条的地方写了回信，感谢女主让他明白这些","x":1550,"y":2695,"width":250,"height":100},
		{"id":"38e998c39a724653","type":"text","text":"主角会在心情低落时收到小纸条","x":1550,"y":1775,"width":250,"height":60},
		{"id":"66b895f4db9f9233","type":"text","text":"主角逐渐尝试“课题分离”（参考书籍《被讨厌的勇气》）","x":1550,"y":1881,"width":250,"height":89},
		{"id":"5f51d506522f64dd","type":"text","text":"女主偷偷观察主角的行动和进步（在纸条上体现）","x":1550,"y":2015,"width":250,"height":60},
		{"id":"9ea5ad2388c73fe5","type":"text","text":"主角认为自己获得了成长，于是在女主放纸条的地方写了回信","x":1550,"y":2135,"width":250,"height":95},
		{"id":"dc4b93e8b1c2bb5a","type":"text","text":"女主不再去秘密基地和幻想空间","x":1550,"y":1675,"width":250,"height":60},
		{"id":"f834b5503628c6e4","type":"text","text":"从无到有","x":-400,"y":-485,"width":250,"height":60},
		{"id":"9a31989504ccea54","type":"text","text":"救赎","x":-400,"y":1215,"width":250,"height":50},
		{"id":"dafb6783c6daadf0","type":"text","text":"主角选择过度依恋女主","x":2300,"y":1405,"width":250,"height":60},
		{"id":"9f72ae46408c057a","type":"text","text":"女主疏远男主","x":2640,"y":1405,"width":250,"height":60},
		{"id":"a9098ae1622e7c4a","type":"text","text":"进入暂时冷静期","x":2980,"y":1405,"width":250,"height":60},
		{"id":"aa4a93d5a0e156bf","type":"text","text":"主角对自身的改变抱有积极态度","x":2300,"y":1600,"width":250,"height":60},
		{"id":"0fab93e682e2edea","type":"text","text":"「我不需要借助你的力量，也可以成长」","x":2640,"y":1600,"width":250,"height":60},
		{"id":"caf4c33b0513176e","type":"text","text":"进入过度独立期","x":2980,"y":1600,"width":250,"height":60},
		{"id":"878475ea744ed631","x":-400,"y":-2720,"width":250,"height":60,"type":"text","text":"第一章 讲述小夜身世"},
		{"id":"0614a082fba2e397","x":140,"y":-2736,"width":250,"height":93,"type":"text","text":"小夜与母亲出逃，二人行至一家小旅店，聊天引出回忆"},
		{"id":"1d0cb6b8098b598c","x":700,"y":-3243,"width":250,"height":60,"type":"text","text":"小夜幼儿时所听到的母亲负面形象"},
		{"id":"28af30f519accc82","x":700,"y":-3123,"width":250,"height":90,"type":"text","text":"小夜经观察发现母亲的真正处境，初步理解母亲受到的不公待遇"},
		{"id":"8f7f96a848094937","x":700,"y":-2979,"width":250,"height":136,"type":"text","text":"小夜对于家里人“女孩子读书有什么用，最后还不是要嫁人”思想的叛逆，自学备考小升初"},
		{"id":"7f2179f66d4edd82","x":700,"y":-2803,"width":250,"height":80,"type":"text","text":"某次父亲酗酒，试图家暴小夜与母亲"},
		{"id":"7518a6b8d194f218","x":700,"y":-2643,"width":250,"height":60,"type":"text","text":"小夜带领母亲出逃，家人并未来寻"},
		{"id":"8399138fec58716a","x":-960,"y":-2440,"width":250,"height":60,"color":"6","type":"text","text":"女主篇\n"},
		{"id":"02ed73f40334fb7c","x":-400,"y":-2120,"width":250,"height":60,"type":"text","text":"第二章 生活现状"},
		{"id":"75a2f346b531b8be","x":140,"y":-2143,"width":250,"height":106,"type":"text","text":"母亲找到一份钟点工家政工作，与小夜在出租屋生活"},
		{"id":"4b72f1d2a2526da7","x":1129,"y":-2308,"width":250,"height":127,"type":"text","text":"小夜对“自己是带来不幸的人”有了新的认知，开始怀疑自己带母亲出逃是否让母亲更幸福。"},
		{"id":"a8078e90060707e5","x":1129,"y":-2090,"width":250,"height":120,"type":"text","text":"小夜不再向母亲透露自己的需求，课余时间帮同学写作业、跑腿挣零用钱，力图不向母亲要钱"},
		{"id":"d0c93ba7327a34ac","x":700,"y":-2181,"width":250,"height":183,"type":"text","text":"小夜偶尔会羡慕其他同学的良好生活，被母亲察觉后，为了让小叶过上更好的生活，母亲身兼数职，某日因回家太晚将自己摔伤。"},
		{"id":"a94f0253eb797e1d","x":700,"y":-2338,"width":250,"height":60,"type":"text","text":"小夜考上新的初中，努力学习"},
		{"id":"85260b09c9fc784a","x":700,"y":-1880,"width":250,"height":160,"type":"text","text":"小夜产生了愈发深刻的赎罪心理与责任感。她试图帮助与拯救身边的许多人，以此抵消自己带来的“不幸”"}
	],
